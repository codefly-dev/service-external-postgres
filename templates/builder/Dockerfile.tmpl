FROM alpine:3.21

ARG TARGETARCH

WORKDIR /app

RUN apk add --no-cache curl postgresql17-client
RUN architecture="${TARGETARCH:-$(apk --print-arch)}" \
    && case "${architecture}" in \
      x86_64) architecture=amd64 ;; \
      aarch64) architecture=arm64 ;; \
      amd64|arm64) ;; \
      *) echo "unsupported target architecture: ${architecture}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/golang-migrate/migrate/releases/download/v4.19.1/migrate.linux-${architecture}.tar.gz" | tar xz \
    && mv migrate /usr/local/bin/migrate

COPY . .

{{- if .WithMigration }}
COPY migrations /app/migrations
{{- end }}
COPY runtime-access.sql /app/runtime-access.sql

CMD set -eu; \
    until pg_isready -d "${{.MigrationConnectionKeyHolder}}" >/dev/null 2>&1; do sleep 2; done; \
{{ if .WithMigration }}    /usr/local/bin/migrate -path /app/migrations -database "${{.MigrationConnectionKeyHolder}}" up; \
{{ end }}    psql "${{.MigrationConnectionKeyHolder}}" --no-psqlrc --set=ON_ERROR_STOP=1 --file=/app/runtime-access.sql
